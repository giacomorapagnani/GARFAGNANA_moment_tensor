# Garfagnana config file
# near stations (local velocity model: garfagnana_near)
#   polarities
#   td: 0.5 - 2.0
--- !grond.Config
rundir_template: runs/${problem_name}.grun
dataset_config: !grond.DatasetConfig
  stations_path: '../META_DATA/stations_garfagnana_INGV_RESIF_UP.pf'
  events_path: '../CAT/catalog_garfagnana.pf'
  waveform_paths: ['../DATA/${event_name}']
  #waveform_paths: ..path/to/waveforms work with continous data
  responses_stationxml_paths: ['../META_DATA/stations_garfagnana_INGV_RESIF_UP.xml']
  extend_incomplete: true
  picks_paths: ['../MARKERS/${event_name}']
  blacklist_paths: ['../BLACKLIST/${event_name}.black']
  whitelist_paths: []
target_groups:

- !grond.PhasePickTargetGroup
  normalisation_family: 'picks'
  path: 'pick.p'
  weight: 1.0
  store_id: 'garfagnana_near'
  pick_synthetic_traveltime: '{stored:P}'
  pick_phasename: 'P'
  weight_traveltime: 1.0
  weight_polarity: 1.0

- !grond.WaveformTargetGroup
  normalisation_family: 'td'
  path: 'td.near'
  weight: 1.0
  interpolation: 'nearest_neighbor'
  store_id: garfagnana_near
  distance_min: 0e3
  distance_max: 50e3
  channels: [R,Z,T]
  exclude: []
  misfit_config: !grond.WaveformMisfitConfig
    fmin: 0.5
    fmax: 2.0
    ffactor: 1.25
    domain: 'time_domain'
    norm_exponent: 1
    tmin: '{stored:P}-0.5'
    tmax: '{stored:S}+1.5'
    tautoshift_max: 1.0
    autoshift_penalty_max: 0.2

problem_config: !grond.CMTProblemConfig
  name_template: cmt_devi_near_local_time_${event_name}
  norm_exponent: 2
  ranges:
    depth: 1000 .. 10000
    duration: 0.1 .. 0.1
    east_shift: -3000 .. 3000
    magnitude: 1. .. 3.
    north_shift: -3000 .. 3000
    rmdd: -1.5708 .. 1.5708
    rmed: -1 .. 1
    rmee: -1.5708 .. 1.5708
    rmnd: -1 .. 1
    rmne: -1 .. 1
    rmnn: -1.5708 .. 1.5708
    time: -2.0 .. 2.0 | add
  distance_min: 100.0
  mt_type: deviatoric
analyser_configs:
- !grond.TargetBalancingAnalyserConfig
  niterations: 2000
optimiser_config: !grond.HighScoreOptimiserConfig
  sampler_phases:
  - !grond.UniformSamplerPhase
    niterations: 5000
    ntries_preconstrain_limit: 1000
  - !grond.DirectedSamplerPhase
    niterations: 30000
    ntries_preconstrain_limit: 1000
    starting_point: excentricity_compensated
    sampler_distribution: normal
    standard_deviation_estimator: median_density_single_chain
    ntries_sample_limit: 1000
  chain_length_factor: 8.0
  nbootstrap: 100
engine_config: !grond.EngineConfig
  gf_stores_from_pyrocko_config: true
  gf_store_superdirs: [../GF_STORES]
  gf_store_dirs: []
event_names: []
event_names_exclude: []